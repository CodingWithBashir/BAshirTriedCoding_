# Local development. In production, use a managed MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/coding-with-bashir
PORT=4000
NODE_ENV=development

# Comma-separated exact browser origins allowed to call the API directly.
# The Vercel frontend normally calls through its same-origin Next.js rewrite.
FRONTEND_ORIGINS=http://localhost:3000

# Admin access is disabled until all values below are configured.
# Use a unique random secret (32+ bytes) and a long, unique password (12+ characters).
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
