# Copy this file to server/.env, then add private local credentials there.
# Never commit server/.env or put real secrets in this template.
# In production, set these values in the Render service environment instead.

# Local MongoDB option:
MONGODB_URI=mongodb://127.0.0.1:27017/coding-with-bashir
# MongoDB Atlas format (replace every placeholder; URL-encode the password):
# MONGODB_URI=mongodb+srv://<DB_USERNAME>:<URL_ENCODED_DB_PASSWORD>@<CLUSTER_HOST>/?appName=<APP_NAME>
PORT=4000
NODE_ENV=development

# Comma-separated exact browser origins allowed to call the API directly.
# The Vercel frontend normally calls through its same-origin Next.js rewrite.
FRONTEND_ORIGINS=http://localhost:3000

# Use a unique random secret of at least 32 bytes for learner and admin sessions.
# Production learner signup/login is disabled unless this and MONGODB_URI are configured.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
